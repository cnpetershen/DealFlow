  classDef ing fill:#FFF4E5,stroke:#C88A2E,stroke-width:1px,color:#4a3000
  classDef eng fill:#E7F6EC,stroke:#2E8B57,stroke-width:1px,color:#10331e
  classDef pol fill:#FFE9D6,stroke:#D2691E,stroke-width:2px,color:#4a2200
  classDef hum fill:#FDE8EC,stroke:#C2185B,stroke-width:1px,color:#4a0d1e
  classDef prt fill:#F3E8FD,stroke:#7A4BBD,stroke-width:1px,color:#2c1145
  classDef run fill:#ECEFF1,stroke:#607D8B,stroke-width:1px,color:#1d2629
  classDef out fill:#E0F7FA,stroke:#00838F,stroke-width:1px,color:#00363a
  classDef cap fill:#FFFDE7,stroke:#C0A000,stroke-width:1px,color:#463c00

  class S1,S2,S3 src
  class W,CP ing
  class HUM hum
  class E1,E2,E3,E4,E6,E7,E9,ER eng
  class E5 pol
  class O1,O2 out
  class P1,P2,P3,P4,P5,P6 prt
  class R1,R3,R4,R5 run
  class C1,C2,C3,C4 cap
