# DealFlow 运行配置示例。
# `npm run dev` / `npm start` / `npm run backup` 会自动加载同目录下的 .env（存在才加载，
# 已在进程环境中设置的变量优先），复制本文件为 .env 后按需修改即可。
# 若由 systemd EnvironmentFile、容器 env_file 等外部方式注入，则无需 .env 文件。
# 未设置的项（含留空的项）一律使用代码内默认值。
# 环境变量只承载部署参数，不承载业务规则（Policy 细则以代码默认值为准）。
# 取值非法会直接启动失败并点名变量，不会静默回退。

# --- HTTP 服务 ---
DEALFLOW_HOST=127.0.0.1
# 留空使用默认 3000；0 表示由系统分配空闲端口（仅测试用）。
DEALFLOW_PORT=3000
# 同时保持的最大连接数，超出的连接会被直接拒绝。
DEALFLOW_MAX_CONNECTIONS=512

# --- SQLite 业务库 ---
# 生产建议放在持久化卷上，并确保运行账户可写。
DEALFLOW_DB_PATH=data/dealflow.db
DEALFLOW_DB_TIMEOUT_MS=5000

# --- 优雅关闭 ---
DEALFLOW_SHUTDOWN_GRACE_MS=10000
# 强制断连后等待在途处理器（正在写审计/释放租约）收尾的上限；必须 >= 外部调用超时
DEALFLOW_SHUTDOWN_ABORT_GRACE_MS=5000

# --- Webhook 入口 ---
DEALFLOW_WEBHOOK_PATH=/webhooks/dealflow
DEALFLOW_WEBHOOK_MAX_BODY_BYTES=1000000
# Bearer Token 与 HMAC 可同时启用；留空表示不校验该方式。
DEALFLOW_WEBHOOK_TOKEN=
DEALFLOW_WEBHOOK_HMAC_SECRET=
# 签名时间戳容忍窗口（秒），超出即拒绝（重放保护）。
DEALFLOW_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# 每个来源每分钟的请求上限；留空使用默认 600，0 表示不限流。
DEALFLOW_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# 部署在反向代理后面时，是否用 X-Forwarded-For 作为限流来源。
# 默认 false：直连时该头可被客户端伪造（伪造地址即可绕过限流）；
# 确实处在可信代理之后才置为 true，否则所有访客共享同一个桶。
DEALFLOW_WEBHOOK_TRUST_PROXY_HEADERS=false

# --- Provider ---
# in-memory 仅用于本地开发；生产使用 http 并配置 base_url。
DEALFLOW_PROVIDER_KIND=in-memory
DEALFLOW_PROVIDER_BASE_URL=
DEALFLOW_PROVIDER_TOKEN=
DEALFLOW_PROVIDER_TIMEOUT_MS=5000

# --- 控制面（人工审核 / 控制操作 / 只读查询）---
# 控制面承载 approve / reject / cancel / retry 与审计、异常查询。
# 必须配置 Token 才启用；未配置时控制面路由返回 404。
# 留空时回退使用 DEALFLOW_WEBHOOK_TOKEN；两者都为空则不暴露控制面。
DEALFLOW_CONTROL_PLANE_ENABLED=true
DEALFLOW_CONTROL_PLANE_TOKEN=
# 控制面独立限流（与 Webhook 分桶）：审批 / 取消 / 重试都是有副作用的写接口，
# 共桶会让 Webhook 突发把审批入口一起打成 429。0 表示不限流。
DEALFLOW_CONTROL_PLANE_RATE_LIMIT_PER_MINUTE=120

# --- 观测 ---
DEALFLOW_OBSERVABILITY_ENABLED=true
# 日志最低级别 debug/info/warn/error；留空表示输出全部级别。
DEALFLOW_LOG_LEVEL=

# --- 失败实例自动重试 ---
# failure_* 字段记录了「可否重试、何时重试」，这里决定是否有组件去读它。
# permanent 与 submitted=unknown 永不自动重试（需人工对账），此处只控制 transient 的退避节奏。
# 布尔取值接受 true/false/1/0/yes/no/on/off（大小写不敏感）。
DEALFLOW_RETRY_ENABLED=true
DEALFLOW_RETRY_INTERVAL_MS=30000
DEALFLOW_RETRY_MAX_ATTEMPTS=3
DEALFLOW_RETRY_MAX_BACKOFF_MS=300000

# --- Workflow ---
DEALFLOW_WORKFLOW_TYPE=lead_follow_up
